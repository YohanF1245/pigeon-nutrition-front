tu es un expert en programmation javascript
tu es un expert avec le framework svelte
le projet est un un site web de gestion de repas et de produits alimentaires
le projet permet de gérer les repas et les produits alimentaires
le projet permet de gérer des stocks d'aliments
le projets permet de gérer une liste de courses a partir d'aliments taggés en stock bas
le projet utilise la charte graphique ci dessous
le projet utilise tailwindcss
le projet est orienté mobile first

# regles des routes pour le front :

### Authentification
- POST /api/auth/register - Inscription
- POST /api/auth/login - Connexion
- GET /api/auth/profile - Obtenir le profil
- PUT /api/auth/profile - Modifier le profil
- POST /api/auth/reset-password - Réinitialiser le mot de passe

### Produits
- GET /api/produits - Liste des produits
- POST /api/produits - Créer un produit
- GET /api/produits/:id - Détails d'un produit
- PUT /api/produits/:id - Modifier un produit
- DELETE /api/produits/:id - Supprimer un produit
- PATCH /api/produits/:id/stock - Mettre à jour le stock
- GET /api/produits/stocks/bas - Vérifier les stocks bas
- GET /api/produits/:id/valeurs-nutritionnelles-tranche - Valeurs nutritionnelles par tranche

### Repas
- GET /api/repas - Liste des repas
- POST /api/repas - Créer un repas
- GET /api/repas/:id - Détails d'un repas
- PUT /api/repas/:id - Modifier un repas
- DELETE /api/repas/:id - Supprimer un repas
- POST /api/repas/:id/compositions - Ajouter des produits au repas
- PUT /api/repas/:id/compositions - Modifier les produits du repas
- DELETE /api/repas/:id/compositions - Supprimer des produits du repas
- GET /api/repas/:id/statistiques - Obtenir les statistiques nutritionnelles
- GET /api/repas/utilisateur/:id/rapport - Obtenir le rapport nutritionnel

### Dashboard
- GET /api/dashboard/statistiques-journalieres - Statistiques journalières
- GET /api/dashboard/apports-nutritionnels - Apports nutritionnels sur une période
- GET /api/dashboard/stocks-bas - Liste des produits en stock bas
- GET /api/dashboard/tendances - Tendances de consommation
- POST /api/dashboard/rapport - Générer un rapport nutritionnel

# regles des formats de données : 

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UniteStock {
  UNITE
  POURCENTAGE
  TRANCHE
}

enum Role {
  ADMIN
  USER
}

model Utilisateur {
  id                String    @id @default(uuid())
  email             String    @unique
  mot_de_passe      String
  nom               String
  prenom            String
  role              Role      @default(USER)
  date_creation     DateTime  @default(now())
  date_modification DateTime  @updatedAt
  produits          Produit[]
  repas             Repas[]
  rapports          RapportNutritionnel[]

  @@map("utilisateurs")
}

model Produit {
  id                String            @id @default(uuid())
  utilisateur_id    String
  utilisateur       Utilisateur       @relation(fields: [utilisateur_id], references: [id])
  nom               String
  code_barre        String?
  calories          Float
  matieres_grasses  Float
  glucides          Float
  proteines         Float
  sel               Float
  stock             Float
  unite_stock       UniteStock       @default(UNITE)
  prix_unitaire     Float
  stock_limite      Float
  date_creation     DateTime         @default(now())
  date_modification DateTime         @updatedAt
  compositions      CompositionRepas[]

  @@unique([utilisateur_id, code_barre])
  @@unique([utilisateur_id, nom])
  @@map("produits")
}

model Repas {
  id                String            @id @default(uuid())
  utilisateur_id    String
  utilisateur       Utilisateur       @relation(fields: [utilisateur_id], references: [id])
  nom               String
  date              DateTime
  description       String?
  date_creation     DateTime         @default(now())
  date_modification DateTime         @updatedAt
  compositions      CompositionRepas[]
  statistiques      StatistiqueRepas[]

  @@unique([id, utilisateur_id], name: "id_utilisateur_id")
  @@map("repas")
}

model CompositionRepas {
  id          String   @id @default(uuid())
  repas_id    String
  repas       Repas    @relation(fields: [repas_id], references: [id])
  produit_id  String
  produit     Produit  @relation(fields: [produit_id], references: [id])
  quantite    Float

  @@map("composition_repas")
}

model StatistiqueRepas {
  id                String    @id @default(uuid())
  repas_id          String
  repas             Repas     @relation(fields: [repas_id], references: [id])
  calories_total    Float
  glucides_total    Float
  proteines_total   Float
  lipides_total     Float
  sel_total         Float
  date_calcul       DateTime  @default(now())

  @@map("statistiques_repas")
}

model RapportNutritionnel {
  id                String    @id @default(uuid())
  utilisateur_id    String
  utilisateur       Utilisateur @relation(fields: [utilisateur_id], references: [id])
  date_debut        DateTime
  date_fin          DateTime
  calories_moyenne  Float
  glucides_moyenne  Float
  proteines_moyenne Float
  lipides_moyenne   Float
  sel_moyenne       Float
  date_generation   DateTime  @default(now())

  @@map("rapports_nutritionnels")
}

